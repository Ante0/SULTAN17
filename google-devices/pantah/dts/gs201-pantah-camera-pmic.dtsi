#include <arm64/exynos/exynos-pinctrl.h>

/ {
	fragment@camera_supply {
		target-path = "/";
		__overlay__ {
			pp3200_bb_cam: cam_supply@0 {
				compatible = "regulator-fixed";
				status = "okay";
				regulator-name = "PP3200_BB_CAM";
				regulator-min-microvolt = <3200000>;
				regulator-max-microvolt = <3200000>;
				/* 2ms */
				regulator-enable-ramp-delay = <2000>;
				enable-active-high;
				/* EN_BB_CAM */
				gpio = <&s2mpg13_gpio 1 GPIO_ACTIVE_HIGH>;
			};
			pp1300_cam: cam_supply@1 {
				compatible = "regulator-fixed";
				status = "okay";
				regulator-name = "PP1300_CAM";
				regulator-min-microvolt = <1300000>;
				regulator-max-microvolt = <1300000>;
				/* 2ms */
				regulator-enable-ramp-delay = <2000>;
				enable-active-high;
				/* EN_BUCK_CAM */
				gpio = <&s2mpg13_gpio 3 GPIO_ACTIVE_HIGH>;
			};
			pp2800_ldaf: ldaf_supply@0 {
				compatible = "regulator-fixed";
				status = "okay";
				regulator-name = "PP2800_LDAF";
				regulator-min-microvolt = <2800000>;
				regulator-max-microvolt = <2800000>;
				regulator-enable-ramp-delay = <0>;
				enable-active-high;
				/* LDAF_LDO_EN */
				gpio = <&gpp8 3 GPIO_ACTIVE_HIGH>;
				vin-supply = <&pp3200_bb_cam>;
			};
		};
	};
};

&hsi2c_8 {
	/* SLG51002 */
	status = "ok";
	#address-cells = <1>;
	#size-cells = <0>;
	slg51002: slg51002@75 {
		compatible = "dlg,slg51002";
		reg = <0x75>;
		status = "ok";
		dlg,cs-gpios = <&s2mpg13_gpio 0 GPIO_ACTIVE_HIGH>;
		dlg,reg-init-cells = <2>;

		regulators {
			slg51002_ldo1: ldo1 {
				regulator-name = "ldo1";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <3750000>;
				vin1_2-supply = <&pp3200_bb_cam>;
			};

			slg51002_ldo2: ldo2 {
				regulator-name = "ldo2";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <3750000>;
				vin1_2-supply = <&pp3200_bb_cam>;
			};

			slg51002_ldo3: ldo3 {
				regulator-name = "ldo3";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <3750000>;
				vin3-supply = <&pp3200_bb_cam>;
			};

			slg51002_ldo4: ldo4 {
				regulator-name = "ldo4";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <3750000>;
				vin4-supply = <&pp3200_bb_cam>;
			};

			slg51002_ldo5: ldo5 {
				regulator-name = "ldo5";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <3750000>;
				vin5-supply = <&pp3200_bb_cam>;
			};

			slg51002_ldo6: ldo6 {
				regulator-name = "ldo6";
				regulator-min-microvolt = <400000>;
				regulator-max-microvolt = <1675000>;
				vin6-supply = <&pp1300_cam>;
			};

			slg51002_ldo7: ldo7 {
				regulator-name = "ldo7";
				regulator-min-microvolt = <400000>;
				regulator-max-microvolt = <1675000>;
				vin7-supply = <&pp1300_cam>;
			};

			slg51002_ldo8: ldo8 {
				regulator-name = "ldo8";
				regulator-min-microvolt = <400000>;
				regulator-max-microvolt = <1675000>;
				vin8-supply = <&pp1300_cam>;
			};

			slg51002_gpio1: gpio1 {
				regulator-name = "gpio1";
				regulator-min-microvolt = <400000>;
				regulator-max-microvolt = <1675000>;
			};

			slg51002_gpio2: gpio2 {
				regulator-name = "gpio2";
				regulator-min-microvolt = <400000>;
				regulator-max-microvolt = <1675000>;
			};

			slg51002_gpio3: gpio3 {
				regulator-name = "gpio3";
				regulator-min-microvolt = <400000>;
				regulator-max-microvolt = <1675000>;
			};

			slg51002_gpio4: gpio4 {
				regulator-name = "gpio4";
				regulator-min-microvolt = <400000>;
				regulator-max-microvolt = <1675000>;
			};
		};

		slg51002_gpio: slg51002_gpio {
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <8>;
			gpio-ranges = <&slg51002_pinctrl 0 0 8>;
		};

		slg51002_pinctrl: slg51002_pinctrl {
		};
	};
};
